import numpy as np
import pandas as pd
df=pd.read_csv("C:/Users/Millit/Downloads/application_train.csv")
df.shape
# df.select_dtypes('int','float').shape
print(df.select_dtypes(['float','int']).shape)
print(df.select_dtypes(['object']).shape)
df.select_dtypes(['object']).shape
df.isna().sum().sum()
df.isna().sum().sort_values(ascending=False)
df['AMT_CREDIT']


q1=df['AMT_CREDIT'].quantile(0.25)
q3=df['AMT_CREDIT'].quantile(0.75)
iqr=q3-q1
utv=q3+1.5*iqr
ltv=q1-1.5*iqr
outlier=df[(df['AMT_CREDIT'] < ltv) | (df['AMT_CREDIT'] > utv)]

outlier.shape
bef=(df['AMT_CREDIT'].memory_usage(deep=True)/ 1024**2)
print('Before:',bef,'MB')
mini=df['AMT_CREDIT'].min()
maxi=df['AMT_CREDIT'].max()
if str(df['AMT_CREDIT'].dtype).startswith('int'):
     if mini>= float(np.iinfo(np.int8).min) and maxi<=float(np.iinfo(np.int8).max):
          df['AMT_CREDIT']=df['AMT_CREDIT'].astype(np.int8)

     
     elif mini>= float(np.iinfo(np.int16).min) and maxi<=float(np.iinfo(np.int16).max):
          df['AMT_CREDIT']=df['AMT_CREDIT'].astype(np.int16)
     # print('done')
     else:
          df['AMT_CREDIT']=df['AMT_CREDIT'].astype(np.int32)

if str(df['AMT_CREDIT'].dtype).startswith('float'):
     if mini>= float(np.finfo(np.float16).min) and maxi<=float(np.finfo(np.float16).max):
          df['AMT_CREDIT']=df['AMT_CREDIT'].astype(np.float16)

     
     elif mini>= float(np.finfo(np.float32).min) and maxi<=float(np.finfo(np.float32).max):
          df['AMT_CREDIT']=df['AMT_CREDIT'].astype(np.float32)
     # print('done')
     else:
          df['AMT_CREDIT']=df['AMT_CREDIT'].astype(np.float64)


aft=float(df['AMT_CREDIT'].memory_usage(deep=True)/ 1024**2)
print('After:',aft, 'MB')
opti=(((bef-aft)/bef)*100)
print(f'Optimization: {opti:.3f} %')


